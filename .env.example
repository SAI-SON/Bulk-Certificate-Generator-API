# Django settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL - used in production)
DB_NAME=certgen_db
DB_USER=certgen_user
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File upload limits
MAX_TEMPLATE_SIZE_MB=10
MAX_PARTICIPANT_FILE_SIZE_MB=5
MAX_PARTICIPANT_ROWS=10000

# Certificate generation
SYNC_GENERATION_THRESHOLD=20
CERTIFICATE_ID_PREFIX=CERT

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File retention (days)
TEMP_FILE_RETENTION_DAYS=7
